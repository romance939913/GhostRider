{
  "name": "ghostrider",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev:api": "turbo run dev --filter=@ghostrider/api",
    "dev:web": "turbo run dev --filter=@ghostrider/web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
